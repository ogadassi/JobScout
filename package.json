{
  "name": "jobscout",
  "version": "2.0.0",
  "private": true,
  "description": "Nightly job-search pipeline: collects jobs from Israeli company job boards, scores them, stores them in Supabase and sends a Telegram digest.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pipeline": "tsx src/index.ts",
    "pipeline:dry": "tsx src/index.ts --dry-run",
    "weekly": "tsx src/index.ts --weekly-only",
    "telegram:chat-id": "tsx src/tools/telegramChatId.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@supabase/supabase-js": "^2.119.0",
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
