# Copy to .env and fill in. Everything is optional:
#   no Supabase  -> jobs saved to data/jobs.json
#   no Telegram  -> digest printed in the terminal
#   no Anthropic -> keyword scores only
# The same names go into GitHub: Settings > Secrets and variables > Actions.

# Supabase (forest-v3 project). URL: Project Settings > Data API.
# Secret key: Project Settings > API Keys > "secret" key (sb_secret_...) or the legacy service_role key.
SUPABASE_URL=https://lyqqpyfvewaufhxhdpmx.supabase.co
SUPABASE_SECRET_KEY=
# SUPABASE_TABLE=jobscout_jobs

# Telegram: create a bot with @BotFather, message it once, then run `npm run telegram:chat-id`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude scoring (https://console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5      # claude-haiku-5-5 is much cheaper
# CLAUDE_MAX_JOBS=40                # max new jobs scored by Claude per run

# Optional: read LinkedIn job-alert emails from Gmail (Google account > Security > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# DIGEST_SIZE=10
# DIGEST_MIN_SCORE=5
# CONTACT=you@example.com           # shown in the User-Agent sent to job-board APIs
