# Copy to .env and fill in. Everything is optional:
#   no Supabase  -> jobs saved to data/jobs.json
#   no email/Telegram -> digest printed in the terminal
#   no Gemini/Anthropic -> keyword scores only
# The same names go into GitHub: Settings > Secrets and variables > Actions.

# Supabase. URL: Project Settings > Data API.
# Secret key: Project Settings > API Keys > "secret" key (sb_secret_...) or the legacy service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# SUPABASE_TABLE=jobscout_jobs

# Where the digest goes: email (default) or telegram
# DIGEST_CHANNEL=email

# Email digest over SMTP. Gmail: turn on 2-step verification, then create an App password.
SMTP_USER=
SMTP_PASSWORD=
DIGEST_EMAIL_TO=                    # several addresses: separate with commas
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Reply commands are read from the same mailbox (IMAP). Who may send them:
# COMMAND_SENDERS=you@gmail.com,assistant@example.com   # default: DIGEST_EMAIL_TO and SMTP_USER
# IMAP_HOST=imap.gmail.com

# Telegram (only with DIGEST_CHANNEL=telegram): create a bot with @BotFather, message it once, then run `npm run telegram:chat-id`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free AI scoring with Gemini (https://aistudio.google.com > Get API key). Used first when set.
GEMINI_API_KEY=
# GEMINI_MODEL=                     # empty = newest flash model the key can use

# Paid alternative: Claude scoring (https://console.anthropic.com > API keys), billed separately from Claude.ai
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5      # claude-haiku-5-5 is much cheaper
# CLAUDE_MAX_JOBS=40                # max new jobs scored by AI (Gemini or Claude) per run

# Optional: read LinkedIn job-alert emails from Gmail (Google account > Security > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# DIGEST_SIZE=10
# DIGEST_MIN_SCORE=5
# CONTACT=you@example.com           # shown in the User-Agent sent to job-board APIs
